# Circle — environment variables. Copy to .env.local (development) or set them in Vercel /
# /opt/circle/supabase/.env (production). Never commit real values.

# ── Database (Supabase) ─────────────────────────────────────────────────────
# PDPL: real patient data must stay in Saudi Arabia (self-hosted, deploy/). A Supabase Cloud
# project outside KSA is for the demo with fictional data only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser
SITE_URL=https://your-domain        # public address, used in links sent to patients
RATE_LIMIT_SALT=                    # random 32+ chars

# ── n8n ↔ Circle ────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=                 # random 32+ chars, same value in n8n's "Circle webhook secret"
N8N_SEND_WEBHOOK_URL=               # n8n "circle-send" webhook (front-desk replies)
N8N_BOOKING_WEBHOOK_URL=            # n8n "Booking from Circle" webhook (confirmations)
N8N_LEAD_WEBHOOK_URL=

# ── WhatsApp (Meta Cloud API, through n8n) ──────────────────────────────────
# Kept in Circle, not in n8n: the n8n workflow asks Circle to check them.
WHATSAPP_VERIFY_TOKEN=              # any long random text; type the same in Meta → Webhook → Verify token
WHATSAPP_APP_SECRET=                # Meta app → App settings → Basic → App secret

# ── WhatsApp AI assistant (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5        # low-cost default; heavier models raise cost
AGENT_EFFORT=                       # only used by non-Haiku models (low|medium|high)

# ── Operations: auto-fix pipeline & scheduled checks ────────────────────────
GITHUB_TOKEN=                       # fine-grained, this repo only, Issues: read & write
GITHUB_REPO=owner/circle
CRON_SECRET=                        # Vercel only: authorises the daily /api/ops/tick cron
