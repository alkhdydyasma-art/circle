{
  "name": "Circle · WhatsApp AI assistant",
  "nodes": [
    {
      "id": "verify",
      "name": "Meta verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "circle-whatsapp-get"
    },
    {
      "id": "token",
      "name": "Verify token matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "t1",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.WHATSAPP_VERIFY_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "challenge",
      "name": "Answer challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      }
    },
    {
      "id": "deny",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        80
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "forbidden",
        "options": {
          "responseCode": 403
        }
      }
    },
    {
      "id": "inbound",
      "name": "WhatsApp message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "circle-whatsapp-post"
    },
    {
      "id": "extract",
      "name": "Extract messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        260
      ],
      "parameters": {
        "jsCode": "// Verifies Meta's signature, then turns the webhook into one item per patient message.\nconst crypto = require('crypto');\nconst out = [];\nfor (const item of $input.all()) {\n  const secret = $env.WHATSAPP_APP_SECRET;\n  const sig = (item.json.headers || {})['x-hub-signature-256'] || '';\n  const raw = item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64') : Buffer.from(JSON.stringify(item.json.body));\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret || '').update(raw).digest('hex');\n  if (!secret || sig.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) continue;\n  const body = item.binary && item.binary.data ? JSON.parse(raw.toString('utf8')) : item.json.body;\n  for (const entry of body.entry || []) {\n    for (const change of entry.changes || []) {\n      const v = change.value || {};\n      const names = Object.fromEntries((v.contacts || []).map((c) => [c.wa_id, c.profile && c.profile.name]));\n      for (const m of v.messages || []) {\n        out.push({ json: {\n          phone_number_id: v.metadata && v.metadata.phone_number_id,\n          from: m.from, name: names[m.from] || null, message_id: m.id, type: m.type,\n          text: m.type === 'text' ? m.text.body : m.type === 'interactive' ? (m.interactive.button_reply || m.interactive.list_reply || {}).title : null,\n        } });\n      }\n    }\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "ask",
      "name": "Ask Circle assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CIRCLE_URL }}/api/whatsapp/inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Circle webhook secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "hasreply",
      "name": "Has a reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "reply",
      "name": "Send reply on WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Extract messages').item.json.phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extract messages').item.json.from }}\",\n  \"type\": \"text\",\n  \"text\": { \"preview_url\": false, \"body\": {{ JSON.stringify($json.reply) }} }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WhatsApp Cloud API"
        }
      }
    }
  ],
  "connections": {
    "Meta verification (GET)": {
      "main": [
        [
          {
            "node": "Verify token matches?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify token matches?": {
      "main": [
        [
          {
            "node": "Answer challenge",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp message (POST)": {
      "main": [
        [
          {
            "node": "Extract messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract messages": {
      "main": [
        [
          {
            "node": "Ask Circle assistant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Circle assistant": {
      "main": [
        [
          {
            "node": "Has a reply?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has a reply?": {
      "main": [
        [
          {
            "node": "Send reply on WhatsApp",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}