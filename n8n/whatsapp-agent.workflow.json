        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "b84f9662-1d2b-4a8c-833a-a6227a9f455c",
      "name": "WhatsApp message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "bbef694e-3674-4367-9d74-3c4e92823f22",
      "notes": "Every patient message arrives here."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {
          "responseCode": 200
        }
      },
      "id": "5edb36d0-6eee-4d0a-a753-fa8174f356e4",
      "name": "Answer Meta 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "notes": "Meta needs a quick 200; the reply is sent afterwards."
    },
    {
      "parameters": {
        "jsCode": "// Meta signs the exact bytes it sent: pass them on untouched (base64) with the signature.\n// Circle checks the signature with the app secret, so the secret never lives in n8n.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const raw = item.binary && item.binary.data\n    ? await this.helpers.getBinaryDataBuffer(i, 'data')\n    : Buffer.from(JSON.stringify(item.json.body || {}));  // not raw: will fail the check, safely\n  const headers = item.json.headers || {};\n  out.push({ json: { signature: headers['x-hub-signature-256'] || '', raw_b64: raw.toString('base64') } });\n}\nreturn out;"
      },
      "id": "b38a34c6-bfe9-42c7-b932-4e8201e08a35",
      "name": "Read raw body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
