{
  "name": "Circle — Ops monitor (hourly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "8b000001-0000-4000-8000-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s0",
              "name": "circle_url",
              "value": "https://circle-mu-eight.vercel.app",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "4e7c5a56-130a-45d1-8887-8747e9842be3",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Your settings for this workflow — edit the values here."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.circle_url }}/api/ops/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "8b000001-0000-4000-8000-000000000002",
      "name": "Ops tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "Credential: Circle webhook secret. Sends recurring errors to the auto-fix pipeline and reads back results. Makes no AI calls.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Circle webhook secret"
        }
      }
    }
  ],
  "connections": {
    "Settings": {
      "main": [
        [
          {
            "node": "Ops tick",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every hour": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}