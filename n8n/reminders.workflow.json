{
  "name": "Circle — WhatsApp appointment reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "6f1a2b3c-0001-4000-8000-000000000001",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $vars.CIRCLE_URL }}/api/v1/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "6f1a2b3c-0002-4000-8000-000000000002",
      "name": "Get due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "notes": "Credential: Header Auth — Name: Authorization, Value: Bearer ck_… (the clinic's key from Circle → الأتمتة)"
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "6f1a2b3c-0003-4000-8000-000000000003",
      "name": "One per appointment",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $vars.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.patient_phone.replace('+', '') }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"appointment_reminder\",\n    \"language\": { \"code\": \"ar\" },\n    \"components\": [\n      { \"type\": \"body\", \"parameters\": [\n        { \"type\": \"text\", \"text\": {{ JSON.stringify($json.patient_name) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify($json.clinic) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify($json.when) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify($json.branch) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify($json.manage_url) }} }\n      ] }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "6f1a2b3c-0004-4000-8000-000000000004",
      "name": "Send WhatsApp template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "notes": "Credential: Header Auth — Name: Authorization, Value: Bearer <WhatsApp Cloud API token>"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.CIRCLE_URL }}/api/v1/reminders/{{ $('One per appointment').item.json.id }}/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "6f1a2b3c-0005-4000-8000-000000000005",
      "name": "Mark as sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "notes": "Same Circle credential as “Get due reminders”"
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Get due reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get due reminders": {
      "main": [
        [
          {
            "node": "One per appointment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per appointment": {
      "main": [
        [
          {
            "node": "Send WhatsApp template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp template": {
      "main": [
        [
          {
            "node": "Mark as sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}