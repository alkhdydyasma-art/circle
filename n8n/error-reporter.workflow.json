{
  "name": "Circle — Error reporter",
  "nodes": [
    {
      "parameters": {},
      "id": "8d000001-0000-4000-8000-000000000001",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s0",
              "name": "circle_url",
              "value": "https://circle-mu-eight.vercel.app",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "78d3b83c-cd68-4e1c-83c3-646e3738b6ad",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Your settings for this workflow — edit the values here."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.circle_url }}/api/ops/report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow.name, node: $json.execution.lastNodeExecuted, message: String($json.execution.error?.message ?? 'unknown error').slice(0, 1500) }) }}"
      },
      "id": "8d000001-0000-4000-8000-000000000002",
      "name": "Report to Circle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "Set this workflow as the Error Workflow of every Circle workflow (Workflow settings → Error workflow).",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Circle webhook secret"
        }
      }
    }
  ],
  "connections": {
    "Settings": {
      "main": [
        [
          {
            "node": "Report to Circle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On workflow error": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}