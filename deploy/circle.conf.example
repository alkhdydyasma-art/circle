# Circle server settings. Copy to /opt/circle/circle.conf, fill in, then run deploy/install.sh.
# Quote values that contain spaces. Avoid the characters $ ` " ' \ in passwords.

# ── Domains (DNS A records must point to the server's public IP) ─────────────
DOMAIN=circle.sa                 # main site, clinic sites and dashboard
N8N_DOMAIN=n8n.circle.sa         # automation editor + WhatsApp webhooks
ACME_EMAIL=you@example.com       # Let's Encrypt notices about the HTTPS certificates

# ── First Circle admin account (created once by install.sh) ──────────────────
ADMIN_EMAIL=you@example.com

# ── Code ─────────────────────────────────────────────────────────────────────
REPO_URL=https://github.com/alkhdydyasma-art/circle.git
REPO_BRANCH=main
SUPABASE_REF=self-hosted/v0.8.2  # pinned, tested Supabase release

# ── Outgoing email (password-reset links for clinic staff) ───────────────────
# Any SMTP provider (e.g. Brevo, Zoho, Resend). Emails carry only a reset link, no patient data.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=no-reply@circle.sa
SMTP_SENDER_NAME=Circle

# ── Off-site backups: Oracle Object Storage, Jeddah (S3-compatible API) ───────
# Endpoint: https://<namespace>.compat.objectstorage.me-jeddah-1.oraclecloud.com
# Keys: Oracle console → Profile → Customer secret keys. Leave empty to keep backups on the server only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=me-jeddah-1
BACKUP_S3_BUCKET=circle-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=35

# ── Alerts (optional) ────────────────────────────────────────────────────────
# A URL that accepts POST {"text": "..."} — e.g. an n8n webhook that forwards to your WhatsApp.
ALERT_WEBHOOK_URL=
